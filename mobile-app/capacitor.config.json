{
  "appId": "com.vdownloader.app",
  "appName": "vdownloader",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
